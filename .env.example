# Copy this file to .env.local for local development.
# Never commit .env.local or production credentials.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADSTERRA_PUBLISHER_ID=YOUR_ADSTERRA_PUBLISHER_ID

# Server-only SociaLens recommendation content-understanding AI.
# Add the real key in Vercel Project Settings -> Environment Variables.
# Do not prefix this variable with NEXT_PUBLIC_.
SOCIALENS_ALGORITHM_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
SOCIALENS_ALGORITHM_GEMINI_MODEL=gemini-3.8-flash

# Server-only AI image editing and object segmentation keys.
# Smart Cutout uses Gemini for object inventory and Roboflow SAM 3 for region guidance.
# Stability AI Inpaint receives the original crop/image, a preservation/removal mask and an explicit prompt;
# Remove Background then returns the transparent object PNG. Keep this dedicated key server-only.
# Keep all keys server-only; never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
ROBOFLOW_API_KEY=YOUR_ROBOFLOW_API_KEY
STABILITY_API_KEY=YOUR_STABILITY_API_KEY
STABILITY_SMART_CUTOUT_API_KEY=YOUR_DEDICATED_STABILITY_API_KEY
STABILITY_API_BASE_URL=https://api.stability.ai

# Server-only Supabase key required for trusted AI-generated metadata writes.
# Keep this secret; never use a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

Warning:
Don't share this api key
